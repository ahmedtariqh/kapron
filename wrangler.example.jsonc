{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapron",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    // Optional base gateway. Set the type to litellm or omniroute and use an HTTPS API base URL.
    // "KAPRON_GATEWAY_PROVIDER": "litellm",
    // "KAPRON_GATEWAY_URL": "https://your-gateway.example/v1",
    "KAPRON_SUPABASE_URL": "https://YOUR-PROJECT.supabase.co"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "kapron",
    "database_id": "REPLACE-WITH-D1-ID",
    "migrations_dir": "drizzle"
  }],
  "triggers": {"crons": ["* * * * *"] }
}
